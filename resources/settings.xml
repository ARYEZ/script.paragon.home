<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
Paragon Home - add-on settings

Written in the pre-Kodi-18 settings format, which is what Krypton reads.
Labels are literal strings rather than string ids so the file stays readable;
the add-on ships a single locale.
-->
<settings>
    <category label="Lights">
        <setting id="run_panel" type="action" label="Open the control panel"
                 action="RunScript(script.paragon.home)" option="close"/>
        <setting id="run_discover" type="action" label="Search for lights now"
                 action="RunScript(script.paragon.home,action=refresh)"
                 option="close"/>
        <setting type="sep"/>
        <setting id="transport_mode" type="enum" label="How to reach the lights"
                 values="Automatic (LAN, then cloud)|LAN only|Cloud only"
                 default="0"/>
        <setting id="discovery_timeout" type="slider"
                 label="LAN search time (seconds)" default="3"
                 range="1,1,15" option="int"/>
        <setting id="command_retries" type="slider"
                 label="Repeat each LAN command this many times" default="2"
                 range="1,1,5" option="int"/>
        <setting id="discover_on_startup" type="bool"
                 label="Search for lights when Kodi starts" default="false"/>
    </category>

    <category label="Govee Cloud">
        <setting type="lsep" label="Only needed for lights without LAN Control"/>
        <setting id="api_key" type="text" label="Govee API key" default=""/>
        <setting id="cloud_timeout" type="slider"
                 label="Request timeout (seconds)" default="10"
                 range="5,1,30" option="int"/>
        <setting id="verify_ssl" type="bool"
                 label="Verify the Govee TLS certificate" default="true"/>
    </category>

    <category label="Kasa">
        <setting type="lsep" label="Only needed for later TP-Link hardware"/>
        <setting type="lsep" label="Used on your network only - never sent to TP-Link"/>
        <setting id="kasa_username" type="text" label="TP-Link account e-mail" default=""/>
        <setting id="kasa_password" type="text" option="hidden"
                 label="TP-Link account password" default=""/>
    </category>

    <category label="SwitchBot">
        <setting type="lsep" label="For blinds and shades, via a SwitchBot hub"/>
        <setting type="lsep" label="App: Profile - Preferences - About,"/>
        <setting type="lsep" label="tap the version ten times for Developer Options"/>
        <setting id="switchbot_token" type="text" option="hidden"
                 label="SwitchBot token" default=""/>
        <setting id="switchbot_secret" type="text" option="hidden"
                 label="SwitchBot secret" default=""/>
    </category>

    <category label="Playback lighting">
        <setting id="playback_sync" type="bool"
                 label="Change the lights with playback" default="false"/>
        <setting id="sync_content" type="enum" label="Apply to"
                 values="Video only|Video and music|Everything" default="0"/>
        <setting id="sync_fullscreen_only" type="bool"
                 label="Only when video is fullscreen" default="false"/>
        <setting id="sync_delay" type="slider"
                 label="Wait before dimming (seconds)" default="0"
                 range="0,1,60" option="int"/>
        <setting type="sep"/>
        <setting id="scene_playing" type="text" label="Scene while playing"
                 default="Movie Night"/>
        <setting id="pick_playing" type="action" label="   Choose..."
                 action="RunScript(script.paragon.home,action=pick_scene&amp;setting=scene_playing)"/>
        <setting id="scene_paused" type="text" label="Scene while paused"
                 default="Paused"/>
        <setting id="pick_paused" type="action" label="   Choose..."
                 action="RunScript(script.paragon.home,action=pick_scene&amp;setting=scene_paused)"/>
        <setting id="scene_stopped" type="text" label="Scene when playback stops"
                 default="Lights Up"/>
        <setting id="pick_stopped" type="action" label="   Choose..."
                 action="RunScript(script.paragon.home,action=pick_scene&amp;setting=scene_stopped)"/>
        <setting type="sep"/>
        <setting id="notify_playback" type="bool"
                 label="Show a notification on each playback change"
                 default="false"/>
    </category>

    <category label="Satellite">
        <setting id="satellite_mode" type="bool"
                 label="This box follows a master box"
                 default="false"/>
        <setting id="master_ip" type="ipaddress"
                 label="Master box address" default=""
                 enable="eq(-1,true)"/>
        <setting id="satellite_sync_minutes" type="slider"
                 label="Copy from the master every (minutes)" default="15"
                 range="5,5,120" option="int" enable="eq(-2,true)"/>
        <setting type="lsep" label="A satellite copies the devices, scenes and sequences from the master and runs no schedule of its own."/>
        <setting type="action" label="Copy from the master now"
                 action="RunScript(script.paragon.home,action=sync)"
                 option="close" enable="eq(-4,true)"/>
    </category>

    <category label="Remote">
        <setting id="remote_enabled" type="bool"
                 label="Serve the web remote on this box"
                 default="false"/>
        <setting id="remote_port" type="number" label="Port" default="8778"
                 enable="eq(-1,true)"/>
        <setting id="remote_pin" type="text" label="PIN" default=""
                 enable="eq(-2,true)"/>
        <setting id="remote_allow_sequences" type="bool"
                 label="Allow sequences from the remote" default="true"
                 enable="eq(-3,true)"/>
        <setting type="lsep" label="A phone on your network can run the scenes, sequences and lights this box knows. A PIN is made for you the first time it starts."/>
        <setting type="action" label="Show the address and PIN"
                 action="RunScript(script.paragon.home,action=remote)"
                 option="close" enable="eq(-5,true)"/>
        <setting type="lsep" label="The remote's Quiet button sets a level rather than muting."/>
        <setting type="lsep" label="In decibels, as the volume bar shows them."/>
        <setting id="tv_quiet_db" type="text" label="Quiet level (dB)"
                 default="-39.3"/>
        <setting id="tv_normal_db" type="text" label="Normal level (dB)"
                 default="-20.0"/>
    </category>

    <category label="Advanced">
        <setting id="bind_address" type="ipaddress"
                 label="Network address to send from (blank = automatic)"
                 default=""/>
        <setting id="startup_delay" type="slider"
                 label="Service start delay (seconds)" default="10"
                 range="0,5,120" option="int"/>
        <setting id="show_notifications" type="bool"
                 label="Show notifications" default="true"/>
        <setting id="debug_logging" type="bool" label="Verbose logging"
                 default="false"/>
    </category>
</settings>
